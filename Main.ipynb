import pandas as pd

# Job description keywords - Nuvvu notes lo unna text nunchi key words teesukundam
jd_keywords = ["embeddings", "retrieval", "ranking", "LLMs", "fine-tuning", "Python", "ML"]

# Sample candidates - Nuvvu test kosam
sample_candidates = [
    {"candidate_id": "cand_001", "resume_text": "5 years ML engineer, built retrieval systems, fine-tuned LLMs, Python expert"},
    {"candidate_id": "cand_002", "resume_text": "3 years data analyst, SQL, Excel, basic Python"},
    {"candidate_id": "cand_003", "resume_text": "8 years AI researcher, embeddings, vector DB, ranking algorithms, PyTorch"},
    {"candidate_id": "cand_004", "resume_text": "7 years backend dev, Java, Spring"},
    {"candidate_id": "cand_005", "resume_text": "6 years ML engineer, RAG, Langchain, ranking, fine-tuning"}
]

# Simple scoring - resume lo keywords entha unnayo count
scores = []
for c in sample_candidates:
    text = c['resume_text'].lower()
    score = sum(1 for word in jd_keywords if word in text)
    scores.append(score)

# Results
df = pd.DataFrame({
    'candidate_id': [c['candidate_id'] for c in sample_candidates],
    'score': scores
})
df = df.sort_values('score', ascending=False).reset_index(drop=True)
df.to_csv('submission.csv', index=False)

print("=== Top Ranked Candidates - No Model Needed ===")
print(df)
print("\nFile ready: submission.csv")
